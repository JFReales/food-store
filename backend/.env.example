# Copiar como .env y completar.

# PostgreSQL (recomendado). Si la base no existe, la API la crea al iniciar.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Alternativa para desarrollo sin PostgreSQL:
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT: mínimo 32 caracteres. Cambiarla en cada instalación.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
